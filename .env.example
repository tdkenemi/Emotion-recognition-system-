# Hướng dẫn cấu hình biến môi trường
# Sao chép file này thành .env và điền thông tin của bạn
# QUAN TRỌNG: KHÔNG bao giờ commit file .env lên GitHub!

# === MongoDB Atlas Connection ===
# Lấy từ: MongoDB Atlas > Connect > Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/emotionai?retryWrites=true&w=majority

# === CORS Origins ===
# Các domain được phép gọi API, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# === JWT Security ===
# TẠO SECRET KEY MẠNH bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Paste kết quả vào đây:
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32_to_generate

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Admin mặc định ===
# Tài khoản Admin được tạo tự động khi server khởi động lần đầu
# PASSWORD phải tối thiểu 8 ký tự!
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_min_8_chars

# === Environment ===
ENVIRONMENT=development
PORT=8000
